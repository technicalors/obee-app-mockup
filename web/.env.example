# Obee Vben Web
#
# pnpm dev reads env files from apps/workspace, not from this root directory.
# For a fresh checkout, create the app env file with:
#
#   cp apps/workspace/.env.example apps/workspace/.env
#
# The values below mirror apps/workspace/.env.example so this root file remains
# a quick reference for the frontend environment.

# Application title
VITE_APP_TITLE=Obee Vben Web

# Application namespace for local storage, store prefixes, and cache isolation
VITE_APP_NAMESPACE=obee-vben-web

# Replace this for any shared development environment
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# Dev server
VITE_PORT=5666
VITE_BASE=/
VITE_GLOB_BACKEND_URL=http://obee.local
# Optional: uncomment all values below to enable Reverb realtime notifications.
# VITE_GLOB_REVERB_APP_KEY=obee-local-key
# VITE_GLOB_REVERB_HOST=obee.local
# VITE_GLOB_REVERB_PORT=8080
# VITE_GLOB_REVERB_SCHEME=http
VITE_NITRO_MOCK=false
VITE_DEVTOOLS=false
VITE_INJECT_APP_LOADING=true
