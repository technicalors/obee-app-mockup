{
  "name": "obee-vben-web",
  "version": "5.7.0",
  "private": true,
  "keywords": [
    "monorepo",
    "vben",
    "vben admin",
    "vben pro",
    "vue",
    "vue admin",
    "vue vben admin",
    "vue vben admin pro",
    "vue3"
  ],
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": "vbenjs/vue-vben-admin.git",
  "license": "MIT",
  "author": {
    "name": "vben",
    "email": "ann.vben@gmail.com",
    "url": "https://github.com/anncwb"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "pnpm run build:obee",
    "build:analyze": "pnpm run build:analyze:obee",
    "build:analyze:obee": "pnpm -F @obee/workspace run build:analyze",
    "build:obee": "pnpm -F @obee/workspace run build",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:format && pnpm run check:oxlint && pnpm run check:eslint && pnpm run check:stylelint && pnpm run check:cspell && pnpm run check:type && pnpm run test:unit && pnpm run check:circular && pnpm run check:dep",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint . --no-progress",
    "check:dep": "vsh check-dep",
    "check:eslint": "eslint . --cache",
    "check:format": "oxfmt --check --threads=2",
    "check:oxlint": "oxlint --threads=2",
    "check:stylelint": "stylelint \"**/*.{vue,css,less,scss}\" --cache",
    "check:type": "pnpm run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "pnpm run dev:obee",
    "dev:obee": "pnpm -F @obee/workspace run dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run --if-present stub",
    "preinstall": "npx only-allow pnpm",
    "prepare": "echo \"Skipping Vben lefthook install inside Obee\"",
    "preview": "pnpm run preview:obee",
    "preview:obee": "pnpm -F @obee/workspace run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm run clean -- --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "typecheck": "pnpm -F @obee/workspace run typecheck",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "catalog": "pnpm dlx codemod pnpm/catalog"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@cspell/dict-vi-vn": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
